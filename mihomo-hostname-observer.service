[Unit]
Description=Optional application hostname observer for mihomo
Before=mihomo.service
ConditionPathExists=/run/mihomo-hostname-target/target.json
ConditionPathIsMountPoint=/sys/fs/bpf
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/mihomo-hostname-observer run-registered
# Runs even after a crash or failed startup. The journal refuses foreign/live
# state; failures remain visible instead of deleting unverified pins.
ExecStopPost=/usr/local/bin/mihomo-hostname-observer cleanup
Restart=on-failure
RestartSec=5
TimeoutStartSec=10
TimeoutStopSec=10

# The target registration pins the process's boot/PID namespace/pidfs birth.
# Neither this root-private input nor the pins are visible to mihomo.
RuntimeDirectory=mihomo-hostname
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0077
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_CHOWN CAP_SYS_PTRACE
NoNewPrivileges=yes
SystemCallFilter=@system-service bpf
SystemCallFilter=~ptrace process_vm_readv process_vm_writev
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# ProtectKernelTunables also makes bpffs read-only. Keep only this pin subtree
# writable instead, with all of /sys and the kernel knobs read-only.
ReadOnlyPaths=/sys /proc
ReadWritePaths=/sys/fs/bpf/mihomo-hostname /run/mihomo-hostname
InaccessiblePaths=-/etc/mihomo
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# No Install section: generated Wants pulls this in only when discovery is on.
