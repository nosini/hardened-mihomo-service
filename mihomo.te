policy_module(mihomo, 1.5)

type mihomo_t;
type mihomo_exec_t;
# /etc/mihomo, read-only
type mihomo_conf_t;
# What mihomo writes in it: ruleset/, cache.db and geoip.metadb
type mihomo_data_t;

init_daemon_domain(mihomo_t, mihomo_exec_t)
# mihomo-sockowner, which attaches the BPF programs that record socket owners
type mihomo_sockowner_t;
type mihomo_sockowner_exec_t;
init_daemon_domain(mihomo_sockowner_t, mihomo_sockowner_exec_t)
files_type(mihomo_conf_t)
files_type(mihomo_data_t)

## <desc>
## <p>
## Allow mihomo to find out which process owns a connection, for PROCESS-NAME and
## PROCESS-PATH rules (find-process-mode). Turn this off if you don't use them.
## </p>
## </desc>
gen_tunable(mihomo_find_process, true)

domain_getattr_all_domains(mihomo_t)

gen_require(`
    type cgroup_t;
    type dns_port_t;
    type http_port_t;
    type init_t;
    type iptables_exec_t;
    type node_t;
    type proc_net_t;
    type kernel_t;
    type proc_t;
    type sysctl_net_t;
    type tun_tap_device_t;
    type unreserved_port_t;
')

allow mihomo_t self:capability { net_admin net_bind_service };

allow mihomo_t self:tcp_socket { accept bind connect create getattr getopt listen read setopt shutdown write };
allow mihomo_t self:udp_socket { bind connect create getattr ioctl read setopt write };
allow mihomo_t self:tun_socket create;
allow mihomo_t self:netlink_route_socket { bind create getattr nlmsg_read nlmsg_write read setopt write };
allow mihomo_t self:netlink_netfilter_socket { bind create getattr getopt read write };
allow mihomo_t self:netlink_tcpdiag_socket { bind create getattr getopt nlmsg_read read write };

allow mihomo_t node_t:tcp_socket node_bind;
allow mihomo_t node_t:udp_socket node_bind;
allow mihomo_t dns_port_t:tcp_socket name_bind;
allow mihomo_t dns_port_t:udp_socket name_bind;
# mihomo is a proxy/router: DIRECT outbounds dial arbitrary destination ports (ssh:22,
# smtp, game servers, ...). Restricting destination ports isn't meaningful here and just
# breaks traffic, so allow TCP connect to all ports.
corenet_tcp_connect_all_ports(mihomo_t)

# mihomo binds listeners (mixed-port, external-controller) and ephemeral source ports for
# outbound dials across the unreserved range; removing either line breaks outbound dials.
allow mihomo_t unreserved_port_t:tcp_socket name_bind;
allow mihomo_t unreserved_port_t:udp_socket name_bind;

allow mihomo_t tun_tap_device_t:chr_file { getattr ioctl open read write };
allow mihomo_t iptables_exec_t:file { execute execute_no_trans getattr open read };

allow mihomo_t mihomo_conf_t:dir { list_dir_perms watch };
allow mihomo_t mihomo_conf_t:file read_file_perms;
# Providers write their files with os.WriteFile and create missing parent directories
manage_dirs_pattern(mihomo_t, mihomo_data_t, mihomo_data_t)
manage_files_pattern(mihomo_t, mihomo_data_t, mihomo_data_t)

# CA bundles and the symlinks that point into them
miscfiles_read_generic_certs(mihomo_t)
# os/exec points a child's unused stdio at /dev/null
dev_rw_null(mihomo_t)

allow mihomo_t proc_t:dir read;
allow mihomo_t proc_t:file { getattr open read };
allow mihomo_t cgroup_t:dir search;
# The Go runtime reads cpu.max to size GOMAXPROCS; without a CPU quota it falls back to
# the CPU count. If mihomo.service ever sets CPUQuota=, use fs_read_cgroup_files(mihomo_t)
# instead, so Go reads the limit.
dontaudit mihomo_t cgroup_t:file { open read };
allow mihomo_t sysctl_net_t:dir search;
allow mihomo_t sysctl_net_t:file { open read };
allow mihomo_t init_t:dir read;
allow mihomo_t init_t:lnk_file read;

allow mihomo_t proc_net_t:file { getattr open read };
allow mihomo_t proc_net_t:dir { getattr open read search };

kernel_read_network_state(mihomo_t)
kernel_read_system_state(mihomo_t)

# Process lookup finds the socket's inode through netlink, then searches the fd links
# under /proc/<pid>/fd of the processes with the socket's UID and reads the owner's exe
# link. Those links belong to other users, so it needs CAP_DAC_READ_SEARCH to list
# them and CAP_SYS_PTRACE to read them. The kernel checks reading them as a read-only
# ptrace access, which SELinux grants through file read on the process's domain.
# Without open on those files and without the ptrace permission, mihomo can't open other
# processes' environ, cmdline or mem.
# What this can't take away: /proc/<pid>/root and cwd are links of the same kind as exe,
# so a compromised mihomo can reach files outside its sandbox through them. Its own type
# enforcement still decides which of those files it can read.
tunable_policy(`mihomo_find_process',`
    allow mihomo_t self:capability { dac_read_search sys_ptrace };
    allow mihomo_t self:cap_userns sys_ptrace;
    allow mihomo_t domain:dir { getattr open read search };
    allow mihomo_t domain:lnk_file { getattr read };
    allow mihomo_t domain:file read;
')

# Kernel module loading for nftables expressions and TUN device
allow mihomo_t kernel_t:system module_request;

########################################
#
# mihomo-sockowner
#

gen_require(`
    type bpf_t;
')

allow mihomo_sockowner_t self:capability { chown net_admin };
allow mihomo_sockowner_t self:capability2 bpf;
allow mihomo_sockowner_t self:bpf { map_create map_read map_write prog_load prog_run };

# Attaching to the root cgroup opens /sys/fs/cgroup
fs_list_cgroup_dirs(mihomo_sockowner_t)
# The Go runtime reads cpu.max to size GOMAXPROCS, as for mihomo above
dontaudit mihomo_sockowner_t cgroup_t:file { open read };
# Pinning the links and the map in /sys/fs/bpf/mihomo; cilium/ebpf checks the filesystem
# type first
allow mihomo_sockowner_t bpf_t:filesystem getattr;
fs_manage_bpf_dirs(mihomo_sockowner_t)
fs_manage_bpf_files(mihomo_sockowner_t)
# Looking up the mihomo group
auth_read_passwd(mihomo_sockowner_t)

# mihomo reads the map through the bind mount of /sys/fs/bpf/mihomo/maps. The map is keyed
# by network namespace, whose cookie mihomo gets with getsockopt(SO_NETNS_COOKIE).
tunable_policy(`mihomo_find_process',`
    allow mihomo_t self:udp_socket getopt;
    fs_list_bpf_dirs(mihomo_t)
    allow mihomo_t bpf_t:file { getattr read };
    allow mihomo_t mihomo_sockowner_t:bpf map_read;
')
