[Unit]
Description=mihomo
After=network-online.target killswitch.service mihomo-sockowner.service
Wants=network-online.target
Requires=killswitch.service

[Service]
Type=simple
User=mihomo
Group=mihomo
# The generator selects the sandbox and replaces this command. If it is missing or
# can't read config.yaml, fail rather than start with mismatched lookup permissions.
ExecStart=/usr/bin/false
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576

# CAP_NET_RAW dropped (no AF_PACKET / raw-socket use). Restore on both lines
# if transparent proxy or raw sockets break.
# The generator adds process-inspection capabilities only for /proc lookup.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# bpf is for reading the maps of mihomo-sockowner.service; see "Process lookup" in README.md.
SystemCallFilter=@system-service bpf
SystemCallFilter=~open_by_handle_at name_to_handle_at kexec_load kexec_file_load swapon swapoff
SystemCallArchitectures=native

TemporaryFileSystem=/:ro
# Config dir is read-only; only the paths mihomo actually updates are writable.
# /proc is read-only too, with other users' processes hidden unless lookup needs them.
# cache.db MUST be writable: profile.store-fake-ip/store-selected open it O_RDWR, and a
# read-only mount breaks the fake-ip store (apps then leak to real IPs).
# ruleset/ and cache.db must exist before start (mihomo.tmpfiles creates them), because
# mihomo can't create files in the read-only /etc/mihomo. geoip.metadb is only needed for
# GEOIP rules and has to be downloaded beforehand for the same reason.
# Trust stores: the CA bundles in /etc/ssl are symlinks into /usr/share (Debian),
# /var/lib/ca-certificates (openSUSE), /etc/pki (Fedora) or /etc/ca-certificates (Arch).
# /etc/resolv.conf and /etc/hosts stay hidden: a file mount point under /etc in the empty
# root would be labeled root_t, and SELinux doesn't let init_t create those (directories
# are fine). Binding all of /etc would expose too much. So the "system" nameserver and
# dns.use-system-hosts don't work; configure DNS explicitly.
BindReadOnlyPaths=/usr /etc/mihomo
BindReadOnlyPaths=-/etc/ssl -/etc/pki -/etc/ca-certificates -/var/lib/ca-certificates
BindPaths=/dev/null /dev/net/tun /etc/mihomo/ruleset /etc/mihomo/cache.db
BindPaths=-/etc/mihomo/geoip.metadb
# The generator binds the BPF maps when process lookup is enabled.
# Binding the host's /proc here would cover the private proc mount and defeat hidepid.
ProtectProc=invisible
ReadOnlyPaths=/proc

ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes
PrivateUsers=no

ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
PrivateTmp=yes
RemoveIPC=yes
UMask=0077
RuntimeDirectory=mihomo
RestrictNamespaces=yes

# Device cgroup allowlist: standard pseudo-devices + TUN. Of those, only /dev/null and
# /dev/net/tun are bound into the sandbox (Go uses getrandom(2), not /dev/urandom).
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw

# W^X memory. Test a full connect/DNS/TUN cycle; remove if mihomo fails to start.
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
